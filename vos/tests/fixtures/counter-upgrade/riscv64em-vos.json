{
  "arch": "riscv64",
  "cpu": "generic-rv64",
  "data-layout": "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128",
  "dynamic-linking": false,
  "executables": true,
  "linker": "rust-lld",
  "linker-flavor": "ld.lld",
  "llvm-abiname": "lp64e",
  "llvm-target": "riscv64",
  "max-atomic-width": 0,
  "metadata": { "description": "VOS PVM actor target", "host_tools": false, "std": false },
  "os": "none",
  "panic-strategy": "abort",
  "position-independent-executables": false,
  "relocation-model": "static",
  "singlethread": true,
  "target-pointer-width": "64"
}
