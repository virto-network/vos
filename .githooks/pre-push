set -euo pipefail

echo "→ pre-push: workspace library tests"
cargo test --workspace --lib --quiet

echo "→ pre-push: Gray Paper v0.8 semantic and ROB-gas corpus"
just test-pvm-vectors

echo "→ pre-push: canonical voucher catalog"
just verify-voucher-check-release

echo "→ pre-push: clean-generation cutover"
just clean-break-check
