 /// The entry for `number`, admitted or not.
 pub fn lookup(number: u32) -> Option<&'static Format> {
+    let spike = SPIKE_FORMAT.load(core::sync::atomic::Ordering::Acquire);
+    if !spike.is_null() {
+        // SAFETY: set once from a leaked `&'static Format`.
+        let spike: &'static Format = unsafe { &*spike };
+        if spike.number == number {
+            return Some(spike);
+        }
+    }
     REGISTRY.iter().find(|format| format.number == number)
 }
 
