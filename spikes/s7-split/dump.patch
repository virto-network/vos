+//! Dumps, for each of the CPU's constraint functions, the main columns its
+//! constraints read and its relation entries (relation, multiplicity, the
+//! columns of the tuple): the input of the CPU split's cell model.
+extern crate std;
+use std::{collections::BTreeSet, fmt::Write as _, string::String, vec::Vec};
+
+use stwo_constraint_framework::{
+    EvalAtRow,
+    expr::{BaseExpr, ExprEvaluator, ExtExpr},
+};
+
+use super::columns::{Column, PreprocessedColumn, Row};
+use super::constraints::{self as c, Lookups};
+use crate::air_column::AirColumn;
+use crate::lookups::ComponentLookupElements;
+use crate::trace::eval::TraceEval;
+
+fn base_cols(e: &BaseExpr, out: &mut BTreeSet<usize>, ev: &ExprEvaluator) {
+    match e {
+        BaseExpr::Col(_) => {
+            let text = e.format_expr();
+            if let Some(rest) = text.strip_prefix("trace_1_column_") {
+                let idx = rest.split('_').next().expect("an index");
+                out.insert(idx.parse().expect("a number"));
+            }
+        }
+        BaseExpr::Const(_) => {}
+        BaseExpr::Param(name) => {
+            if let Some(x) = ev.intermediates.get(name) {
+                base_cols(x, out, ev);
+            }
+        }
+        BaseExpr::Add(a, b) | BaseExpr::Sub(a, b) | BaseExpr::Mul(a, b) => {
+            base_cols(a, out, ev);
+            base_cols(b, out, ev);
+        }
+        BaseExpr::Neg(a) | BaseExpr::Inv(a) => base_cols(a, out, ev),
+    }
+}
+
+fn ext_cols(e: &ExtExpr, out: &mut BTreeSet<usize>, rel: &mut BTreeSet<String>, ev: &ExprEvaluator) {
+    match e {
+        ExtExpr::SecureCol(parts) => parts.iter().for_each(|p| base_cols(p, out, ev)),
+        ExtExpr::Const(_) => {}
+        ExtExpr::Param(name) => {
+            if let Some(x) = ev.ext_intermediates.get(name) {
+                ext_cols(x, out, rel, ev);
+            } else if let Some(stem) = name.strip_suffix("_z") {
+                rel.insert(stem.into());
+            }
+        }
+        ExtExpr::Add(a, b) | ExtExpr::Sub(a, b) | ExtExpr::Mul(a, b) => {
+            ext_cols(a, out, rel, ev);
+            ext_cols(b, out, rel, ev);
+        }
+        ExtExpr::Neg(a) => ext_cols(a, out, rel, ev),
+    }
+}
+
+
+fn py(e: &BaseExpr, ev: &ExprEvaluator) -> String {
+    match e {
+        BaseExpr::Col(_) => {
+            let text = e.format_expr();
+            let rest = text.strip_prefix("trace_").expect("a column");
+            let mut parts = rest.split('_');
+            let interaction = parts.next().unwrap();
+            let idx = parts.nth(1).unwrap();
+            let offset = text.rsplit("offset_").next().unwrap().replace("neg_", "-");
+            format!("c({interaction},{idx},{offset})")
+        }
+        BaseExpr::Const(v) => format!("{}", v.0),
+        BaseExpr::Param(name) => match ev.intermediates.get(name) {
+            Some(x) => py(x, ev),
+            None => format!("p('{name}')"),
+        },
+        BaseExpr::Add(a, b) => format!("({}+{})", py(a, ev), py(b, ev)),
+        BaseExpr::Sub(a, b) => format!("({}-{})", py(a, ev), py(b, ev)),
+        BaseExpr::Mul(a, b) => format!("({}*{})", py(a, ev), py(b, ev)),
+        BaseExpr::Neg(a) => format!("(-{})", py(a, ev)),
+        BaseExpr::Inv(a) => format!("inv({})", py(a, ev)),
+    }
+}
+
+fn py_ext(e: &ExtExpr, ev: &ExprEvaluator) -> String {
+    match e {
+        ExtExpr::SecureCol(parts) => {
+            let v: Vec<String> = parts.iter().map(|x| py(x, ev)).collect();
+            format!("[{}]", v.join(","))
+        }
+        ExtExpr::Param(name) => match ev.ext_intermediates.get(name) {
+            Some(x) => py_ext(x, ev),
+            None => panic!("an extension parameter {name} in a constraint"),
+        },
+        other => panic!("an extension expression in a constraint: {}", other.format_expr()),
+    }
+}
+
+fn set(s: &BTreeSet<usize>) -> String {
+    let v: Vec<String> = s.iter().map(|x| x.to_string()).collect();
+    format!("[{}]", v.join(","))
+}
+
+fn run(name: &str, json: &mut String, f: impl FnOnce(&mut ExprEvaluator, &Row<BaseExpr>, &Lookups, BaseExpr)) {
+    let mut ev = ExprEvaluator::new();
+    let trace = TraceEval::<PreprocessedColumn, Column, ExprEvaluator>::new(&mut ev);
+    let is_p2 = ev.next_trace_mask();
+    let row = Row::new(&trace);
+    let lookups = Lookups::dummy();
+    f(&mut ev, &row, &lookups, is_p2);
+    let mut cons = Vec::new();
+    for k in &ev.constraints {
+        let (mut cols, mut rel) = (BTreeSet::new(), BTreeSet::new());
+        ext_cols(k, &mut cols, &mut rel, &ev);
+        cons.push(format!("{{\"cols\":{},\"py\":\"{}\"}}", set(&cols), py_ext(k, &ev)));
+    }
+    let mut fracs = Vec::new();
+    for fr in &ev.logup.fracs {
+        let (mut mult, mut tuple, mut rel) = (BTreeSet::new(), BTreeSet::new(), BTreeSet::new());
+        ext_cols(&fr.numerator, &mut mult, &mut BTreeSet::new(), &ev);
+        ext_cols(&fr.denominator, &mut tuple, &mut rel, &ev);
+        let rel: Vec<String> = rel.into_iter().collect();
+        fracs.push(format!(
+            "{{\"relation\":\"{}\",\"mult\":{},\"mult_py\":\"{}\",\"tuple\":{}}}",
+            rel.join("+"),
+            set(&mult),
+            py_ext(&fr.numerator, &ev),
+            set(&tuple)
+        ));
+    }
+    let _ = write!(
+        json,
+        "{{\"fn\":\"{name}\",\"constraints\":[{}],\"fractions\":[{}]}}",
+        cons.join(","),
+        fracs.join(",")
+    );
+}
