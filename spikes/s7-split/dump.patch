+thread_local! {
+    static MIX_ACTOR: std::cell::RefCell<String> = const { std::cell::RefCell::new(String::new()) };
+}
+
+/// With `S7_MIX` naming a file, a traced kernel's opcode histogram and the
+/// segment AIR's natural log sizes, a line of JSON per window: every 2^15
+/// chunk, and the prefixes of 2^14 and 2^16 steps.
+pub fn dump_mix(label: &str, side_note: &vos_pvm_proof::SideNote) {
+    let Some(path) = std::env::var_os("S7_MIX") else { return };
+    let steps = &side_note.steps;
+    let n = steps.len();
+    let mut windows: Vec<(String, usize, usize)> = (0..n)
+        .step_by(1 << 15)
+        .map(|from| ("chunk15".to_string(), from, (from + (1 << 15)).min(n)))
+        .collect();
+    windows.push(("prefix12".into(), 0, n.min(1 << 12)));
+    windows.push(("prefix13".into(), 0, n.min(1 << 13)));
+    windows.push(("prefix14".into(), 0, n.min(1 << 14)));
+    windows.push(("prefix15".into(), 0, n.min(1 << 15)));
+    windows.push(("prefix16".into(), 0, n.min(1 << 16)));
+    windows.push(("whole".into(), 0, n));
+    let mut code: std::collections::BTreeMap<String, usize> = Default::default();
+    for (pc, &byte) in side_note.code.iter().enumerate() {
+        if side_note.bitmask.get(pc) != Some(&1) {
+            continue;
+        }
+        if let Some((op, _)) = vos_pvm::instruction::decode_opcode_fast(byte) {
+            *code.entry(format!("{op:?}")).or_default() += 1;
+        }
+    }
+    let code: Vec<String> = code.iter().map(|(k, v)| format!("\"{k}\":{v}")).collect();
+    let mut out = format!(
+        "{{\"kernel\":\"{label}\",\"steps\":{n},\"window\":\"code\",\"code\":{{{}}}}}\n",
+        code.join(",")
+    );
+    for (kind, from, to) in windows {
+        let mut by: std::collections::BTreeMap<String, usize> = Default::default();
+        for step in &steps[from..to] {
+            let name = format!("{:?}", step.opcode);
+            let name = if name == "Ecalli" { format!("Ecalli:{}", step.imm) } else { name };
+            *by.entry(name).or_default() += 1;
+        }
+        let mix: Vec<String> = by.iter().map(|(k, v)| format!("\"{k}\":{v}")).collect();
+        let logs = if kind == "whole" && n > (1 << 16) {
+            None
+        } else {
+            vos_pvm_proof::canonical_profile_for_bounds(side_note, &[(from, to)])
+        };
+        let mut touched = std::collections::BTreeSet::new();
+        let mut witness = 0usize;
+        for step in &steps[from..to] {
+            for access in [&step.mem_read, &step.mem_write].into_iter().flatten() {
+                for i in 0..access.size as u32 {
+                    touched.insert(access.address.wrapping_add(i));
+                }
+            }
+            if let Some(write) = &step.witness {
+                witness += write.bytes.len();
+                for i in 0..write.bytes.len() as u32 {
+                    touched.insert(write.address.wrapping_add(i));
+                }
+            }
+        }
+        let distinct = touched.len();
+        let mem_bytes: usize = steps[from..to]
+            .iter()
+            .flat_map(|step| [&step.mem_read, &step.mem_write])
+            .flatten()
+            .map(|access| access.size as usize)
+            .sum();
+        out.push_str(&format!(
+            "{{\"kernel\":\"{label}\",\"steps\":{n},\"window\":\"{kind}\",\"from\":{from},\"to\":{to},\"mem_bytes\":{mem_bytes},\"witness_bytes\":{witness},\"distinct\":{distinct},\"log_sizes\":{:?},\"mix\":{{{}}}}}\n",
+            logs.unwrap_or_default(),
+            mix.join(",")
+        ));
+    }
+    use std::io::Write;
+    std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .unwrap()
+        .write_all(out.as_bytes())
+        .unwrap();
+}
