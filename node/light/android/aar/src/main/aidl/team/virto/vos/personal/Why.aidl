package team.virto.vos.personal;

/** Why a personal operation was refused: what the screen acts on. */
@Backing(type="byte")
enum Why {
    NONE = 0,
    NO_SPACE = 1,
    ALREADY_HELD = 2,
    HOLDS_KEYS = 3,
    CLAIM_ELSEWHERE = 4,
    AT_THAT_HOME = 5,
    NO_RESTORE = 6,
    NO_PAIRING = 7,
    NEEDS_REPAIR = 8,
    DECLINED = 9,
    CANCELLED = 10,
    NOT_A_KIT = 11,
    WRONG_KIT = 12,
    NOT_A_PAIRING_CODE = 13,
    NOT_AN_OFFER = 14,
    STALE_OFFER = 15,
    OWN_KEY = 16,
    NOT_IN_SET = 17,
    SOURCE = 18,
    NO_OPEN_CLAIM = 19,
    OPEN_CLAIM_REFUSED = 20,
    NO_AGENT_TO_GIVE = 21,
    NO_AGENT_FOR_KIT = 22,
    HOLDS_AGENT_THERE = 23,
    UNKNOWN_AGENT = 24,
    NO_LEAF = 25,
    HOME_REFUSED = 26,
    UPDATE = 27,
    REJECTED = 28,
    AGENT_REFUSED = 29,
    NOT_TAKEN_YET = 30,
    NOT_JOINED_YET = 31,
    AWAITS_VOTES = 32,
    UNDECIDED = 33,
    COMMIT_VOID = 34,
    COMMITTED_MEANWHILE = 35,
    SLOT_EXPIRED = 36,
    IN_SET_ALREADY = 37,
    NOT_IN_AGENT_SET = 38,
    REGROUPED = 39,
    NOT_ENROLLED = 40,
    NOTHING_OWED = 41,
    SPENT = 42,
    REGISTRAR_REFUSED = 43,
    UNREACHABLE = 44,
    PROVE = 45,
    STORE = 46,
    ARGUMENTS = 47,
    FAILED = 48,
    DELAYED_ADMIN = 49,
    PAIRING_DECLINED = 50,
}
